# ============================================================================
# Production Environment Configuration (DigitalOcean)
# Copy to .env on the droplet and fill secrets
# ============================================================================

# OpenAI
OPENAI_API_KEY=__PUT_YOUR_KEY_HERE__
GPT_MODEL=gpt-4o-mini

# Server
PORT=3001
NODE_ENV=production
LOG_LEVEL=info

# Frontend
FRONTEND_PORT=5173
PUBLIC_URL=http://__DROPLET_IP__

# Security / Rate limiting (optional future use)
MAX_TOKENS_PER_REQUEST=4000

# ============================================================================
# Notes:
# - Do NOT commit the real .env file
# - FRONTEND_PORT used only if running dev server; for production we build
# - PUBLIC_URL should be replaced with domain if you add one later
# ============================================================================
