# ============================================================================
# MAIZE Collective Intelligence - .gitignore
# ============================================================================

# ============================================================================
# DATI SENSIBILI E CONFIGURAZIONE
# ============================================================================

# Variabili d'ambiente (contiene API keys!)
.env
.env.local
.env.*.local

# Backup del vecchio server
server/index-old.js

# README vecchi
README-old.md

# ============================================================================
# DOCUMENTI E DATI
# ============================================================================

# Documenti sorgente (possono contenere dati riservati)
docs/
docs_not_txt/
txt_output/

# Vectorstore (contiene embeddings dei documenti)
vectorstore.json
vectorstore.json.old
vectorstore.*.json

# File temporanei di conversione
*.tmp
*.temp

# ============================================================================
# NODE.JS
# ============================================================================

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing
coverage/
*.lcov
.nyc_output

# Production builds
dist/
build/
*.local

# ============================================================================
# PYTHON
# ============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
env/
ENV/
.venv

# Python distribution / packaging
.Python
*.egg-info/
dist/
build/

# ============================================================================
# EDITOR E IDE
# ============================================================================

# Visual Studio Code
.vscode/
*.code-workspace

# IntelliJ IDEA
.idea/
*.iml

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# ============================================================================
# SISTEMA OPERATIVO
# ============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory

# ============================================================================
# LOG FILES
# ============================================================================

# Logs generici
*.log
logs/
*.log.*

# PM2 logs
.pm2/

# ============================================================================
# TEMPORARY FILES
# ============================================================================

# Backup files
*.bak
*.backup
*.old

# Temporary files
tmp/
temp/
*.tmp
*.temp

# ============================================================================
# ALTRI FILE DA ESCLUDERE
# ============================================================================

# File compressi
*.zip
*.tar
*.tar.gz
*.rar

# Certificati e chiavi
*.pem
*.key
*.cert
*.crt

# Database locali
*.db
*.sqlite
*.sqlite3

# Cache
.cache/
.parcel-cache/
.next/
.nuxt/
