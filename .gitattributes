# ============================================================================
# MAIZE Collective Intelligence - Git Attributes
# ============================================================================

# Auto detect text files and perform LF normalization
* text=auto

# ============================================================================
# TEXT FILES
# ============================================================================

*.md text
*.txt text
*.json text
*.js text
*.mjs text
*.jsx text
*.ts text
*.tsx text
*.css text
*.html text
*.py text
*.sh text eol=lf
*.bash text eol=lf

# ============================================================================
# CONFIGURATION FILES
# ============================================================================

.gitignore text
.gitattributes text
.env.example text
package.json text
package-lock.json text -diff
tsconfig.json text

# ============================================================================
# BINARY FILES
# ============================================================================

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary

# ============================================================================
# LARGE FILES (Git LFS)
# ============================================================================

# Vectorstore files (large JSON files)
vectorstore.json filter=lfs diff=lfs merge=lfs -text
*.vectorstore.json filter=lfs diff=lfs merge=lfs -text
