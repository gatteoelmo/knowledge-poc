    "build-all": "npm run setup && npm run frontend-build",
    "prod-start": "pm2 start ecosystem.config.cjs && pm2 status",
    "full-start": "npm run setup && concurrently \"npm run start\" \"npm run frontend\"",
    "quick-start": "concurrently \"npm run start\" \"npm run frontend\"",
    "security-check": "./scripts/shell/security-check.sh",
    "precommit": "npm run security-check"
