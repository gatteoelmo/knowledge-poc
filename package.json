    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node server/index.js",
    "dev": "npm run start",
    "frontend": "cd frontend && npm run dev",
    "frontend-build": "cd frontend && npm run build",
    "frontend-serve": "npx serve -l 5173 frontend/dist",
    "setup": "npm run convert && npm run load",
    "convert": "python3 scripts/convert_to_txt_all.py",
    "load": "node scripts/load_docs.mjs",
